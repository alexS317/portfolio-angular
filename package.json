    "front-matter": "^4.0.2",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
